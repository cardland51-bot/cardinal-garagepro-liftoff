# ====== Core Server ======
NODE_ENV=production
PORT=10000
DATA_DIR=/data
ORIGIN_ALLOWLIST=https://yourdomain.com,https://www.yourdomain.com

# ====== Identity / Cookies ======
COOKIE_NAME=wa_device
COOKIE_SECURE=true

# ====== Uploads / Limits ======
MAX_UPLOAD_MB=7
ALLOWED_MIME=image/jpeg,image/png,image/webp
VIDEO_MAX_FACTOR=3

# ====== Feature Flags / Modes ======
MAINTENANCE=false
PAYWALL_DISABLED=false
PREVIEW_DEVICE=

# ====== Inference (image → price band) ======
INFER_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ====== Transcription (video/audio → text) ======
INFER_TRANSCRIBE_PROVIDER=stub
OPENAI_TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANG=en
FFMPEG_PATH=

# ====== Text Guardrails (optional tuning) ======
ALLOW_TOPICS=garage,epoxy,driveway,roof,lawn,mulch,wash,concrete,pressure,seal,gutter,deck,fence,roofing,paint,window,paver,asphalt
SANITIZE_NOTES=true

# ====== Paywall / Monetization ======
PRICE_USD=19
FREE_LIMIT=2
BILLING_PROVIDER=paypal

# PayPal
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# Stripe (optional)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Braintree (optional)
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
BRAINTREE_PLAN_ID=

# ====== Admin / Analytics ======
ADMIN_TOKEN=change-me-strong
ANALYTICS_ENABLE=true
EVENTS_SAMPLE_RATE=1.0

# ====== Community Submissions / Geo Index (optional) ======
GEO_BASELINE_INDEX=1.0
GEO_INDEX_URL=

# ====== Logging / Observability ======
LOG_LEVEL=info
LOG_TO_FILE=true
SENTRY_DSN=
SENTRY_ENV=production

# ====== Email / Notifications (future) ======
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cardinal GaragePro <no-reply@yourdomain.com>"

# ====== Storage Backends (future migrations) ======
STORAGE_DRIVER=disk
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Database (optional)
DATABASE_URL=
DB_MAX_POOL=5

# Cache / Queue (optional)
REDIS_URL=
QUEUE_DRIVER=memory

# ====== PWA / Frontend (optional meta) ======
PUBLIC_APP_NAME=Cardinal GaragePro
PUBLIC_THEME_COLOR=#0f172a
PUBLIC_ACCENT_COLOR=#f97316
PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# ====== CORS extras (optional) ======
CORS_ALLOW_CREDENTIALS=true
CORS_EXPOSE_HEADERS=X-Preview

# ====== Security Hardening ======
DISABLE_INDEX_LISTING=true
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
